    "require": {
      "types": "./dist/index.d.cts",
      "default": "./dist/index.cjs"
    }
  },
  "devDependencies": {
    "pkgroll": "^2.27.0",
    "tsx": "^4.19.2",
    "typescript": "^5.8.3",
    "vitest": "^4.1.7"
  }
}
